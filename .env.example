# RA.Aid environment configuration
#
# Copy this file to `.env` and fill in the values you need:
#   cp .env.example .env
#
# Only the provider(s) you actually use require an API key. The
# `EXPERT_*` variables configure the "expert" sub-agent (a second,
# optional model the main agent can delegate to); leave them unset to
# disable that feature.

# ---------------------------------------------------------------------------
# Primary LLM provider (pick one; the others are optional)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_API_BASE=            # custom / OpenAI-compatible endpoint

GEMINI_API_KEY=

GROQ_API_KEY=

DEEPSEEK_API_KEY=

FIREWORKS_API_KEY=

OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Expert sub-agent (optional; unset to disable)
# ---------------------------------------------------------------------------
# EXPERT_ANTHROPIC_API_KEY=
# EXPERT_ANTHROPIC_MODEL=
# EXPERT_OPENAI_API_KEY=
# EXPERT_OPENAI_MODEL=
# EXPERT_OPENAI_API_BASE=
# EXPERT_GEMINI_API_KEY=
# EXPERT_GROQ_API_KEY=
# EXPERT_DEEPSEEK_API_KEY=
# EXPERT_FIREWORKS_API_KEY=
# EXPERT_OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Web research (optional)
# ---------------------------------------------------------------------------
# TAVILY_API_KEY=             # enables the web-research tool

# ---------------------------------------------------------------------------
# Optional behaviour flags
# ---------------------------------------------------------------------------
# AIDER_FLAGS=                # extra flags passed to aider when --use-aider
# LITELLM_LOG=                # set to "ERROR"/"WARNING" to quiet litellm
